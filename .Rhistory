# Set parameters
G <- 1e6            # length of chain
burn_in <- 1e6     # burn-in period
# Create storage vector
X <- matrix(nrow=G,ncol=1)
# Set initial state x0 = 1 or 2 or 3
x0 <- 2
# Markov chain
x <- x0     # set initial value
for (g in 1:(burn_in+G)) {
# Get appropriate transition probabilities given x Pr(i=x -> j)
probs <- P[x,]
# Generate new x
mydraw <- runif(1, 0, 1)
if( 0 <= mydraw & mydraw < probs[1]){
x <- 1
} else if ( probs[1] <= mydraw & mydraw < probs[1] + probs[2]) {
x <- 2
} else if (mydraw > probs[1] + probs[2]){
x <- 3
}
# Store draw
if (g > burn_in){
X[g-burn_in] <- x
}
}
# Compute invariant distribution
pi_simul <- c(sum(X==1)/G,sum(X==2)/G,sum(X==3)/G)
print(pi_simul)
print(pi)
